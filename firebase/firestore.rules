rules_version = '2';

// Firestore security rules (docs/research/design-review-security-cost.md §1.4, docs/research/M2-interfaces.md §2).
//
// Firestore is private: the public viewer never reads it (it fetches the static manifest from the
// public bucket). Only verified Google accounts that hold the `admin` custom claim AND have an
// admins/{uid} document read or write here; everything else is denied by default. Cloud Functions
// and the Cloud Run job use the Admin SDK, which bypasses these rules, so every server writer
// re-validates with the shared zod schemas. Server-owned documents (admins, setup, invites, usage,
// ops, manifests, job logs, history) have no client write rule at all.
//
// The client-writable fields mirror CLIENT_WRITES (packages/shared/src/schemas/client-writes.ts)
// field by field: a create may contain exactly the `create` fields, an update may change exactly
// the `update` fields, everything else is server-owned. The value checks follow the zod document
// schemas (schemas/firestore.ts, schemas/firestore-ops.ts) within two limits of the rules language:
//
// - One request may evaluate at most 1000 expressions, and every reference to a function argument
//   evaluates the argument again (a single check costs about ten). So each field gets as few checks
//   as possible: a text is one bounded pattern (`[\s\S]{1,200}`: a string of 1 to 200 characters;
//   zod also trims, so a blank optional text passes here and is refused by the server), an optional
//   field is checked with its neutral default (`data.get('bearing', 0)`), and the heaviest
//   legitimate write stays well within the limit (rules-tests/test/limits.test.ts).
// - Rules have no loops: links are checked one by one (at most five), a geometry by its size, its
//   first vertex and its closing vertex, the theme's token maps by their sizes. What rules cannot see
//   (each token value, Markdown links, every vertex) is checked again by the manifest builder, which
//   skips a document its schema refuses (M2-interfaces §3.5).
//
// Every write validates the whole document it leaves; on update the city bounds are only consulted
// when the photo's location changes, so an edit never fails on a city boundary moved since.
//
// Tests: firebase/rules-tests (allow/deny matrix per persona, collection and operation; field
// validation per entity). The tests stage fails when any expression below was never evaluated or
// an `allow` never allowed or never denied a request (scripts/ci/check_rules_coverage.py).
service cloud.firestore {
    match /databases/{database}/documents {

        // ---- Who is asking -----------------------------------------------------------------

        // A signed-in, verified Google account: admins only ever sign in with Google.
        function authed() {
            return request.auth != null
                && request.auth.token.email_verified == true
                && request.auth.token.firebase.sign_in_provider == 'google.com';
        }

        // The custom claim alone stays valid in an ID token for up to an hour after revocation;
        // also requiring admins/{uid} makes removing an admin take effect immediately.
        function isAdmin() {
            return authed()
                && request.auth.token.get('admin', false) == true
                && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
        }

        // ---- Value checks ------------------------------------------------------------------
        //
        // A check reads every key it needs: a missing key is an error, and an error denies.

        // Patterns of a string of 1 to N characters (`matches` refuses anything but a string). RE2
        // repeats stop at 1000, so longer bounds chain blocks of at most 1000.
        function upTo2000() {
            return '[\\s\\S]{1,1000}[\\s\\S]{0,1000}';
        }

        function upTo5000() {
            return upTo2000() + '[\\s\\S]{0,1000}[\\s\\S]{0,1000}[\\s\\S]{0,1000}';
        }

        function upTo10000() {
            return upTo5000() + '[\\s\\S]{0,1000}[\\s\\S]{0,1000}[\\s\\S]{0,1000}[\\s\\S]{0,1000}[\\s\\S]{0,1000}';
        }

        // An absolute https URL of at most 2048 characters without credentials or white space (no
        // javascript:, data: or http:): what zod `httpsUrlSchema` accepts, a little stricter.
        function httpsUrl() {
            return 'https://[^\\s/?#@]{1,253}([/?#][^\\s]{0,999}[^\\s]{0,786})?';
        }

        // {ro, en?}: Romanian required, English optional (zod `localizedPartial`), `pattern` bounds both.
        function localized(value, pattern) {
            return value.keys().hasOnly(['ro', 'en']) && value.ro.matches(pattern) && value.get('en', 'x').matches(pattern);
        }

        // A required title or name: also never blank.
        function titled(value, pattern) {
            return localized(value, pattern) && value.ro.matches('[\\s\\S]*\\S[\\s\\S]*');
        }

        // Ids of photos, POIs, categories and jobs (`ID_PATTERN`): what paths and the manifest accept.
        function isId(value) {
            return value.matches('[A-Za-z0-9_-]{1,40}');
        }

        // A year 1800-2100: the digits of an integer (a fraction or a string never matches both).
        function isYear(value) {
            return value is int && string(value).matches('18[0-9][0-9]|19[0-9][0-9]|20[0-9][0-9]|2100');
        }

        // {lat, lng} in degrees: photo locations and POI vertices.
        function latLng(value) {
            return value.keys().hasOnly(['lat', 'lng'])
                && value.lat >= -90
                && value.lat <= 90
                && value.lng >= -180
                && value.lng <= 180;
        }

        // A labelled link {url, label}.
        function link(value) {
            return value.keys().hasOnly(['url', 'label']) && value.url.matches(httpsUrl()) && value.label.matches('[\\s\\S]{1,200}');
        }

        // At most five links (`MAX_LINKS`), each checked.
        function validLinks(links) {
            return links.size() <= 5
                && (links.size() < 1 || link(links[0]))
                && (links.size() < 2 || link(links[1]))
                && (links.size() < 3 || link(links[2]))
                && (links.size() < 4 || link(links[3]))
                && (links.size() < 5 || link(links[4]));
        }

        // Every client write records who made it, with the server's clock (serverTimestamp()).
        function stamped(data) {
            return data.updatedBy == request.auth.uid && data.updatedAt == request.time;
        }

        // A client create also records its creator, once.
        function created(data) {
            return data.createdBy == request.auth.uid && data.createdAt == request.time;
        }

        // The keys an update changes, adds or removes.
        function changedKeys() {
            return request.resource.data.diff(resource.data).affectedKeys();
        }

        // ---- Cities (CLIENT_WRITES.city: update only) --------------------------------------

        // {west, south, east, north} in degrees, west < east and south < north.
        function validBounds(bounds) {
            return bounds.keys().hasOnly(['west', 'south', 'east', 'north'])
                && bounds.west >= -180
                && bounds.west < bounds.east
                && bounds.east <= 180
                && bounds.south >= -90
                && bounds.south < bounds.north
                && bounds.north <= 90;
        }

        // One generated colour scheme: 1 to MAX_TOKENS (200) tokens; the builder checks each value.
        function tokenMap(value) {
            return value is map && value.size() >= 1 && value.size() <= 200;
        }

        function validTheme(theme) {
            return theme.keys().hasOnly(['seedColor', 'tokens'])
                && theme.seedColor.matches('#[0-9A-Fa-f]{6}')
                && theme.tokens.keys().hasOnly(['light', 'dark', 'highContrastLight', 'highContrastDark'])
                && tokenMap(theme.tokens.light)
                && tokenMap(theme.tokens.dark)
                && tokenMap(theme.tokens.highContrastLight)
                && tokenMap(theme.tokens.highContrastDark);
        }

        // `mapbox://styles/<owner>/<style>` or an https style URL, plus at most 30 Standard config properties.
        function validBasemap(basemap) {
            return basemap.keys().hasOnly(['style', 'config'])
                && basemap.style.matches('mapbox://styles/[A-Za-z0-9_-]{1,64}/[A-Za-z0-9_-]{1,64}|' + httpsUrl())
                && basemap.get('config', {}) is map
                && basemap.get('config', {}).size() <= 30;
        }

        // The settings an admin edits; id, mapbox, analytics, engine and createdAt are server-owned.
        function validCity(data) {
            return titled(data.name, '[\\s\\S]{1,100}')
                && validBounds(data.bounds)
                && (!('center' in data) || latLng(data.center))
                && data.get('zoom', 0) >= 0 && data.get('zoom', 0) <= 24
                && data.get('minZoom', 0) >= 0 && data.get('minZoom', 0) <= 24
                && data.get('maxZoom', 0) >= 0 && data.get('maxZoom', 0) <= 24
                && localized(data.get('about', {'ro': 'x'}), upTo10000())
                && localized(data.get('privacy', {'ro': 'x'}), upTo10000())
                && data.get('credits', []) is list
                && data.get('credits', []).size() <= 50
                && (!('theme' in data) || validTheme(data.theme))
                && (!('basemap' in data) || validBasemap(data.basemap))
                && (!('photosOverlay' in data)
                    || (data.photosOverlay.keys().hasOnly(['defaultOpacity'])
                        && data.photosOverlay.defaultOpacity >= 0
                        && data.photosOverlay.defaultOpacity <= 1))
                && data.published is bool
                && stamped(data);
        }

        // ---- Photos (CLIENT_WRITES.photo) --------------------------------------------------

        // Within the city's bounds, with half a degree of slack for photos taken from outside them.
        function inCity(location, city) {
            let bounds = get(/databases/$(database)/documents/cities/$(city)).data.bounds;
            return location.keys().hasOnly(['lat', 'lng'])
                && location.lat >= bounds.south - 0.5
                && location.lat <= bounds.north + 0.5
                && location.lng >= bounds.west - 0.5
                && location.lng <= bounds.east + 0.5;
        }

        // The photo as an admin leaves it; image, exif, processing, processingError, duplicateOf,
        // suggested and original belong to photos.onUpload, createdAt and createdBy to the create.
        // The location is checked by the caller (against the city only when it changes).
        function validPhoto(data) {
            return titled(data.title, '[\\s\\S]{1,200}')
                && localized(data.get('description', {'ro': 'x'}), upTo5000())
                && localized(data.get('dateText', {'ro': 'x'}), '[\\s\\S]{1,100}')
                // zod `validYearRange`: an end year needs a start year, and never comes before it.
                && isYear(data.get('year', 1800))
                && (!('yearEnd' in data) || (isYear(data.yearEnd) && data.year <= data.yearEnd))
                && data.get('author', 'x').matches('[\\s\\S]{1,200}')
                && data.get('rightsHolder', 'x').matches('[\\s\\S]{1,200}')
                && data.get('sourceLabel', 'x').matches('[\\s\\S]{1,200}')
                && data.get('sourceUrl', 'https://x').matches(httpsUrl())
                && data.get('permissionNote', 'x').matches(upTo2000())
                && data.get('legacyId', 'x').matches('[\\s\\S]{1,64}')
                && validLinks(data.get('links', []))
                && data.get('bearing', 0) >= 0 && data.get('bearing', 0) <= 360
                && data.get('fov', 1) >= 1 && data.get('fov', 1) <= 180
                && data.license in ['CC0', 'CC-BY-4.0', 'CC-BY-SA-4.0', 'PD', 'permission', 'permission-legacy', 'unknown']
                && data.published is bool
                && data.get('rightsReview', false) is bool
                && stamped(data);
        }

        // Publishing needs processed derivatives (photos.onUpload wrote `image`) and a known licence.
        function publishable(data) {
            return data.published == false
                || (resource.data.processing == 'done' && 'image' in resource.data && data.license != 'unknown');
        }

        // ---- Layers (CLIENT_WRITES.layer: update only) -------------------------------------

        // LAYER_ADJUSTMENT_RANGES (absent means neutral); brightness min never above max.
        function validAdjustments(value) {
            return value.keys().hasOnly(['brightnessMin', 'brightnessMax', 'contrast', 'saturation'])
                && value.get('brightnessMin', 0) >= 0
                && value.get('brightnessMin', 0) <= value.get('brightnessMax', 1)
                && value.get('brightnessMax', 1) <= 1
                && value.get('contrast', 0) >= -1 && value.get('contrast', 0) <= 1
                && value.get('saturation', 0) >= -1 && value.get('saturation', 0) <= 1;
        }

        // The presentation an admin edits; the pipeline owns the source, zooms, bounds, status,
        // provenance and Mapbox ids.
        function validLayer(data) {
            return isYear(data.year)
                // `YYYY-MM-DD` (zod `z.iso.date`; the calendar check is the server's).
                && data.get('date', '2000-01-01').matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
                && titled(data.label, '[\\s\\S]{1,200}')
                && localized(data.get('description', {'ro': 'x'}), upTo5000())
                && data.get('attribution', 'x').matches('[\\s\\S]{1,500}')
                && data.order is int
                && data.opacity >= 0 && data.opacity <= 1
                && data.defaultVisible is bool
                && validAdjustments(data.get('adjustments', {}))
                && data.published is bool
                && stamped(data);
        }

        // ---- POI categories (CLIENT_WRITES.poiCategory) ------------------------------------

        function validCategory(data) {
            return titled(data.label, '[\\s\\S]{1,100}')
                && data.icon.matches('[a-z0-9_]{1,64}')
                && data.color.matches('#[0-9A-Fa-f]{6}')
                && data.defaultOpacity >= 0 && data.defaultOpacity <= 1
                && data.order is int
                && stamped(data);
        }

        // ---- POIs (CLIENT_WRITES.poi) ------------------------------------------------------

        // A list of `least` to 500 (MAX_GEOMETRY_VERTICES) {lat, lng} vertices; the first is checked here.
        function vertices(points, least) {
            return points.size() >= least && points.size() <= 500 && latLng(points[0]);
        }

        // geometryDocSchema: Point {point}, LineString {points}, Polygon {rings: [{points}]} (1 to 20
        // rings, each closed: it ends where it starts; the outer ring is checked in full).
        function validGeometry(geometry) {
            return geometry.type in ['Point', 'LineString', 'Polygon']
                && (geometry.type != 'Point' || (geometry.keys().hasOnly(['type', 'point']) && latLng(geometry.point)))
                && (geometry.type != 'LineString' || (geometry.keys().hasOnly(['type', 'points']) && vertices(geometry.points, 2)))
                && (geometry.type != 'Polygon' || (geometry.keys().hasOnly(['type', 'rings'])
                    && geometry.rings.size() >= 1
                    && geometry.rings.size() <= 20
                    && geometry.rings[0].keys().hasOnly(['points'])
                    && vertices(geometry.rings[0].points, 4)
                    && geometry.rings[0].points[0] == geometry.rings[0].points[geometry.rings[0].points.size() - 1]
                    && geometry.rings[geometry.rings.size() - 1].points.size() >= 4
                    && geometry.rings[geometry.rings.size() - 1].points[0]
                        == geometry.rings[geometry.rings.size() - 1].points[geometry.rings[geometry.rings.size() - 1].points.size() - 1]));
        }

        function validPoi(data) {
            return isId(data.category)
                && validGeometry(data.geometry)
                && titled(data.title, '[\\s\\S]{1,200}')
                && localized(data.get('description', {'ro': 'x'}), upTo5000())
                // zod `validYearSpan`: either bound may be missing, never inverted.
                && isYear(data.get('yearStart', 1800))
                && isYear(data.get('yearEnd', 2100))
                && data.get('yearStart', 1800) <= data.get('yearEnd', 2100)
                && validLinks(data.get('links', []))
                && data.get('photoIds', []) is list
                && data.get('photoIds', []).size() <= 20
                && data.published is bool
                && stamped(data);
        }

        // ---- Matches -----------------------------------------------------------------------

        // Default deny: nothing is readable or writable unless a rule below allows it.
        match /{document=**} {
            allow read, write: if false;
        }

        // Written by admin.claim, admin.join, admins.revoke and the bootstrap script only. A signed-in
        // Google account reads its own document (admin.session tells the app the rest).
        match /admins/{uid} {
            allow read: if isAdmin() || (authed() && request.auth.uid == uid);
        }

        // setup/status (non-secret health: secrets live in Secret Manager, never here) and setup/owner.
        match /setup/{doc} {
            allow read: if isAdmin();
        }

        // Invitations, keyed by the SHA-256 of the invited address (the address itself is never stored).
        match /invites/{invite} {
            allow read: if isAdmin();
        }

        // Mapbox usage counters (usage/mapbox-YYYY-MM).
        match /usage/{doc} {
            allow read: if isAdmin();
        }

        // The budget guard and the last ops.tick (ops/guard).
        match /ops/{doc} {
            allow read: if isAdmin();
        }

        // Each city's manifest builds (the admin's "Published" chip); publish.* writes them.
        match /manifests/{city} {
            allow read: if isAdmin();
        }

        // History's recent changes (M2c, CR-M2c-6): one collection-group query over every audited document's
        // `history` subcollection, kept to one city by the `cityId` each entry carries (CR-M2c-14; the composite
        // indexes start with it). Admins, who edit every city of the map, list them; a single entry is read only
        // under cities/ (a `history` document anywhere else stays closed, as every path the contract does not name: a
        // condition on the path cannot hold for a collection-group query, so it guards `get` alone). No client writes
        // an entry.
        match /{path=**}/history/{entry} {
            allow list: if isAdmin();
            allow get: if isAdmin() && path[0] == 'cities';
        }

        // Cities are created and deleted by callables; admins edit the settings.
        match /cities/{city} {
            allow read: if isAdmin();
            allow update: if isAdmin()
                && changedKeys().hasOnly(['name', 'bounds', 'center', 'zoom', 'minZoom', 'maxZoom', 'about', 'privacy', 'credits',
                    'theme', 'basemap', 'photosOverlay', 'published', 'updatedBy', 'updatedAt'])
                && validCity(request.resource.data);

            // Every audited document keeps a `history` subcollection written by the history.*
            // triggers and history.revert only: admins read it, nobody writes it from a client.
            match /history/{entry} {
                allow read: if isAdmin();
            }

            // New photos start unpublished and unprocessed; photos.onUpload owns the image fields.
            match /photos/{photo} {
                allow read: if isAdmin();
                allow create: if isAdmin()
                    && isId(photo)
                    && request.resource.data.keys().hasOnly(['title', 'description', 'year', 'yearEnd', 'dateText', 'author', 'license',
                        'rightsHolder', 'sourceUrl', 'sourceLabel', 'permissionNote', 'legacyId', 'links', 'location', 'bearing', 'fov',
                        'published', 'rightsReview', 'processing', 'createdAt', 'createdBy', 'updatedBy', 'updatedAt'])
                    && validPhoto(request.resource.data)
                    && inCity(request.resource.data.location, city)
                    && request.resource.data.processing == 'pending'
                    && request.resource.data.published == false
                    && created(request.resource.data);
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['title', 'description', 'year', 'yearEnd', 'dateText', 'author', 'license', 'rightsHolder',
                        'sourceUrl', 'sourceLabel', 'permissionNote', 'legacyId', 'links', 'location', 'bearing', 'fov', 'published',
                        'rightsReview', 'updatedBy', 'updatedAt'])
                    && validPhoto(request.resource.data)
                    && (!('location' in changedKeys()) || inCity(request.resource.data.location, city))
                    && (!changedKeys().hasAny(['published', 'license']) || publishable(request.resource.data));
                allow delete: if isAdmin();

                match /history/{entry} {
                    allow read: if isAdmin();
                }
            }

            // Layers are created by the pipeline; admins edit presentation, opacity and adjustments.
            match /layers/{layer} {
                allow read: if isAdmin();
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['label', 'description', 'attribution', 'year', 'date', 'order', 'opacity', 'defaultVisible',
                        'adjustments', 'published', 'updatedBy', 'updatedAt'])
                    && validLayer(request.resource.data);

                match /history/{entry} {
                    allow read: if isAdmin();
                }
            }

            // Points of interest, drawn and edited by admins.
            match /pois/{poi} {
                allow read: if isAdmin();
                allow create: if isAdmin()
                    && isId(poi)
                    && request.resource.data.keys().hasOnly(['category', 'geometry', 'title', 'description', 'yearStart', 'yearEnd',
                        'links', 'photoIds', 'published', 'createdAt', 'createdBy', 'updatedBy', 'updatedAt'])
                    && validPoi(request.resource.data)
                    && created(request.resource.data);
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['category', 'geometry', 'title', 'description', 'yearStart', 'yearEnd', 'links', 'photoIds',
                        'published', 'updatedBy', 'updatedAt'])
                    && validPoi(request.resource.data);
                allow delete: if isAdmin();

                match /history/{entry} {
                    allow read: if isAdmin();
                }
            }

            // POI categories share the overlay namespace with layer ids and `photos` (PHOTOS_OVERLAY_ID).
            match /poiCategories/{category} {
                allow read: if isAdmin();
                allow create: if isAdmin()
                    && isId(category)
                    && category != 'photos'
                    && request.resource.data.keys().hasOnly(['label', 'icon', 'color', 'defaultOpacity', 'order', 'createdAt', 'updatedBy',
                        'updatedAt'])
                    && validCategory(request.resource.data)
                    && request.resource.data.createdAt == request.time;
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['label', 'icon', 'color', 'defaultOpacity', 'order', 'updatedBy', 'updatedAt'])
                    && validCategory(request.resource.data);
                allow delete: if isAdmin();

                match /history/{entry} {
                    allow read: if isAdmin();
                }
            }

            // Admins queue jobs and may ask an unfinished one to stop; the job runner owns every other
            // field and validates `params` per type.
            match /jobs/{job} {
                allow read: if isAdmin();
                allow create: if isAdmin()
                    && isId(job)
                    && request.resource.data.keys().hasOnly(['type', 'status', 'params', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
                    && request.resource.data.type in ['usgs-import', 'geotiff-import', 'regeoref', 'republish']
                    && request.resource.data.status == 'queued'
                    && request.resource.data.params is map
                    && created(request.resource.data)
                    && stamped(request.resource.data);
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['cancelRequested', 'updatedBy', 'updatedAt'])
                    && request.resource.data.cancelRequested == true
                    && stamped(request.resource.data)
                    && !(resource.data.status in ['succeeded', 'failed', 'cancelled']);

                // Redacted job log lines, written by the job runner only.
                match /logs/{line} {
                    allow read: if isAdmin();
                }
            }

            // USGS scenes are harvested server-side; admins triage them (candidate, ordered, rejected)
            // and annotate them, whatever state the harvest left them in.
            match /usgsScenes/{scene} {
                allow read: if isAdmin();
                allow update: if isAdmin()
                    && changedKeys().hasOnly(['status', 'note', 'updatedBy', 'updatedAt'])
                    && (!('status' in changedKeys()) || request.resource.data.status in ['candidate', 'ordered', 'rejected'])
                    && request.resource.data.get('note', 'x').matches('[\\s\\S]{1,1000}')
                    && stamped(request.resource.data);
            }
        }
    }
}
