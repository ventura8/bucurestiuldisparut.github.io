{
    "call": "POST https://secretmanager.googleapis.com/v1/projects/<project>/secrets?secretId=<secret>",
    "status": 409,
    "body": {
        "error": {
            "code": 409,
            "message": "Secret [projects/{{projectNumber}}/secrets/{{secretId}}] already exists.",
            "status": "ALREADY_EXISTS"
        }
    }
}
