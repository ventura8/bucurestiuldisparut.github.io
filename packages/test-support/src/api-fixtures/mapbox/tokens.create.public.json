{
    "call": "POST https://api.mapbox.com/tokens/v2/<user>?access_token=<sk>",
    "status": 201,
    "body": {
        "client": "api",
        "usage": "pk",
        "id": "{{tokenId}}",
        "default": false,
        "note": "{{note}}",
        "scopes": ["styles:read", "styles:tiles", "fonts:read"],
        "created": "2026-10-12T08:30:00.000Z",
        "modified": "2026-10-12T08:30:00.000Z",
        "allowedUrls": ["https://ventura8.github.io"],
        "token": "{{token}}"
    }
}
