{
    "call": "GET https://iam.googleapis.com/v1/projects/<project>/serviceAccounts",
    "status": 200,
    "body": {
        "accounts": [
            {
                "name": "projects/{{projectId}}/serviceAccounts/{{accountId}}@{{projectId}}.iam.gserviceaccount.com",
                "projectId": "{{projectId}}",
                "uniqueId": "100000000000000000101",
                "email": "{{accountId}}@{{projectId}}.iam.gserviceaccount.com",
                "displayName": "{{displayName}}",
                "etag": "MDEwMjE5MjA=",
                "oauth2ClientId": "100000000000000000101"
            }
        ]
    }
}
