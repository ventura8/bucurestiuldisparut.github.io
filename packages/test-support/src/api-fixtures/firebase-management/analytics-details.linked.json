{
    "call": "GET https://firebase.googleapis.com/v1beta1/projects/<project>/analyticsDetails",
    "status": 200,
    "body": {
        "analyticsProperty": {
            "id": "properties/{{analyticsPropertyId}}",
            "displayName": "Historic City Map",
            "analyticsAccountId": "300000001"
        },
        "streamMappings": [
            {
                "app": "projects/{{projectId}}/webApps/{{appId}}",
                "streamId": "500000001",
                "measurementId": "{{measurementId}}"
            }
        ]
    }
}
