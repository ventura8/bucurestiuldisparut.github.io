{
    "name": "@hcm/test-support",
    "version": "0.0.0",
    "private": true,
    "description": "Test-only helpers shared by every TS test project (fakes, recorders; from M1 the FakeMap and API fixtures). Never imported by product code.",
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./axe": {
            "types": "./src/axe.ts",
            "default": "./src/axe.ts"
        },
        "./fake-map": {
            "types": "./src/fake-map.ts",
            "default": "./src/fake-map.ts"
        }
    },
    "dependencies": {
        "@hcm/shared": "0.0.0",
        "axe-core": "4.14.0"
    }
}
