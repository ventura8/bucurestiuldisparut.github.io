{
    "name": "@hcm/shared",
    "version": "1.0.0",
    "private": true,
    "description": "Environment-neutral code shared by the engine, admin and functions: logging, i18n catalogues (RO default, EN, and the viewer's 14 more languages) and, from M1, zod schemas.",
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./admin-worker": {
            "types": "./src/i18n/admin-worker/index.ts",
            "default": "./src/i18n/admin-worker/index.ts"
        },
        "./admin-worker-local": {
            "types": "./src/i18n/admin-worker-local/index.ts",
            "default": "./src/i18n/admin-worker-local/index.ts"
        },
        "./map-labels": {
            "types": "./src/i18n/map-labels/index.ts",
            "default": "./src/i18n/map-labels/index.ts"
        },
        "./viewer-catalogues": {
            "types": "./src/i18n/viewer-catalogues.ts",
            "default": "./src/i18n/viewer-catalogues.ts"
        }
    },
    "dependencies": {
        "zod": "4.6.7"
    }
}
