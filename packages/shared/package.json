    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./admin-worker": {
            "types": "./src/i18n/admin-worker/index.ts",
            "default": "./src/i18n/admin-worker/index.ts"
        },
        "./admin-archive": {
            "types": "./src/i18n/admin-archive/index.ts",
            "default": "./src/i18n/admin-archive/index.ts"
        },
        "./admin-tiles": {
            "types": "./src/i18n/admin-tiles/index.ts",
            "default": "./src/i18n/admin-tiles/index.ts"
        },
        "./admin-worker-local": {
            "types": "./src/i18n/admin-worker-local/index.ts",
            "default": "./src/i18n/admin-worker-local/index.ts"
        },
        "./admin-worker-household": {
            "types": "./src/i18n/admin-worker-household/index.ts",
            "default": "./src/i18n/admin-worker-household/index.ts"
        },
        "./admin-sources": {
            "types": "./src/i18n/admin-sources/index.ts",
            "default": "./src/i18n/admin-sources/index.ts"
