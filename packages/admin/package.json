{
    "name": "@hcm/admin",
    "version": "1.0.0-beta.1",
    "private": true,
    "description": "Admin app (Setup Assistant, photos, satellite layers, georeferencer, jobs): builds dist/admin.{iife.js,mjs,css}, served from Firebase Hosting; `build:e2e` builds it against the Firebase emulators and the OAuth stand-in.",
    "license": "UNLICENSED",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./start": {
            "types": "./src/start/index.ts",
            "default": "./src/start/index.ts"
        },
        "./setup/steps": {
            "types": "./src/setup/steps.ts",
            "default": "./src/setup/steps.ts"
        },
        "./content/budgets": {
            "types": "./src/content/budgets.ts",
            "default": "./src/content/budgets.ts"
        },
        "./google/scopes": {
            "types": "./src/google/scopes.ts",
            "default": "./src/google/scopes.ts"
        }
    },
    "scripts": {
        "build": "vite build && vite build --config vite.start.config.ts",
        "build:e2e": "vite build --mode e2e && vite build --config vite.start.config.ts --mode e2e"
    },
    "dependencies": {
        "@hcm/shared": "1.0.0-beta.1",
        "@hcm/ui": "1.0.0-beta.1",
        "firebase": "13.1.0",
        "web-vitals": "6.2.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@hcm/test-support": "1.0.0-beta.1"
    }
}
