// Unit tests of @hcm/ui, type-checked apart from src/ so Node and Vitest types never leak into product code.
{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        // Vitest's own declarations (including the browser-mode API) reference Node types such as BufferEncoding;
        // `vite/client` types `import.meta.glob`, with which viewer/theme-tokens.test.ts reads the viewer's sources.
        "types": ["node", "vite/client"]
    },
    "include": ["."],
    "references": [{ "path": ".." }, { "path": "../../test-support" }]
}
