{
    "name": "@hcm/ui",
    "version": "1.0.0-beta.1",
    "private": true,
    "description": "Material 3 (Expressive) Lit 3 component kit: hcm-* custom elements, theme tokens and window classes.",
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./admin": {
            "types": "./src/admin/index.ts",
            "default": "./src/admin/index.ts"
        },
        "./admin/worker": {
            "types": "./src/admin/worker/define.ts",
            "default": "./src/admin/worker/define.ts"
        },
        "./admin/archive": {
            "types": "./src/admin/archive/define.ts",
            "default": "./src/admin/archive/define.ts"
        },
        "./admin/worker/local": {
            "types": "./src/admin/worker/hcm-worker-local.ts",
            "default": "./src/admin/worker/hcm-worker-local.ts"
        },
        "./admin/worker/household": {
            "types": "./src/admin/worker/hcm-worker-household.ts",
            "default": "./src/admin/worker/hcm-worker-household.ts"
        },
        "./admin/areas/*": {
            "types": "./src/admin/areas/*.ts",
            "default": "./src/admin/areas/*.ts"
        },
        "./admin/georef/marker-badge": {
            "types": "./src/admin/georef/marker-badge.ts",
            "default": "./src/admin/georef/marker-badge.ts"
        },
        "./start": {
            "types": "./src/start/hcm-start-page.ts",
            "default": "./src/start/hcm-start-page.ts"
        },
        "./dynamic-color": {
            "types": "./src/theme/dynamic-color.ts",
            "default": "./src/theme/dynamic-color.ts"
        },
        "./map": {
            "types": "./src/map/index.ts",
            "default": "./src/map/index.ts"
        },
        "./map/draw": {
            "types": "./src/map/draw/index.ts",
            "default": "./src/map/draw/index.ts"
        },
        "./viewer/gamepad": {
            "types": "./src/viewer/gamepad/gamepad.ts",
            "default": "./src/viewer/gamepad/gamepad.ts"
        },
        "./viewer/compare": {
            "types": "./src/viewer/compare/index.ts",
            "default": "./src/viewer/compare/index.ts"
        }
    },
    "scripts": {
        "theme:gen": "node scripts/gen-theme.mjs",
        "fonts:build": "node scripts/build-fonts.mjs",
        "fonts:check": "node scripts/build-fonts.mjs --check"
    },
    "dependencies": {
        "@hcm/shared": "1.0.0-beta.1",
        "@material/material-color-utilities": "0.4.0",
        "lit": "3.3.3",
        "terra-draw": "1.39.0",
        "terra-draw-mapbox-gl-adapter": "1.5.0"
    },
    "devDependencies": {
        "@fontsource-variable/roboto-flex": "5.3.0",
        "@hcm/test-support": "1.0.0-beta.1",
        "harfbuzzjs": "1.6.4",
        "material-symbols": "0.49.0",
        "wawoff2": "2.0.1"
    }
}
