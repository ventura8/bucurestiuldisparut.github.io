{
    "name": "@hcm/ui",
    "version": "0.0.0",
    "private": true,
    "description": "Material 3 (Expressive) Lit 3 component kit: hcm-* custom elements, theme tokens and window classes.",
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./admin": {
            "types": "./src/admin/index.ts",
            "default": "./src/admin/index.ts"
        },
        "./dynamic-color": {
            "types": "./src/theme/dynamic-color.ts",
            "default": "./src/theme/dynamic-color.ts"
        }
    },
    "scripts": {
        "theme:gen": "node scripts/gen-theme.mjs",
        "fonts:build": "node scripts/build-fonts.mjs",
        "fonts:check": "node scripts/build-fonts.mjs --check"
    },
    "dependencies": {
        "@hcm/shared": "0.0.0",
        "@material/material-color-utilities": "0.4.0",
        "lit": "3.3.3"
    },
    "devDependencies": {
        "@fontsource-variable/roboto-flex": "5.3.0",
        "@hcm/test-support": "0.0.0",
        "harfbuzzjs": "1.6.3",
        "material-symbols": "0.48.0",
        "wawoff2": "2.0.1"
    }
}
