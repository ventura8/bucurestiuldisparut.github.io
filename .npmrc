# Refuse to install on a Node outside package.json "engines" (>=24.12.0, required by
# @firebase/rules-unit-testing). The host may have an older Node: run npm in the pinned
# node:24 image or the quality image instead (docs/research/M0-handoff.md).
engine-strict=true
# Every dependency is pinned to an exact version; "npm install <pkg>" writes "1.2.3", never "^1.2.3".
save-exact=true
# Lockfile v3 only (npm >= 9); no audit/fund noise during installs, audits run as a gate.
lockfile-version=3
fund=false
audit=false
