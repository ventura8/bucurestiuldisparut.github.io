{
    "$schema": "https://unpkg.com/knip@6.44.0/schema.json",
    "workspaces": {
        ".": {
            "entry": ["scripts/*/test/**/*.test.ts"],
            "project": ["*.{js,cjs,ts}", "scripts/site/**/*.ts", "scripts/release/**/*.ts", "scripts/*/test/**/*.ts"]
        },
        "packages/test-support": {
            "project": ["src/**/*.ts"]
        },
        "packages/ui": {
            "entry": ["test/**/*.test.ts", "scripts/test/**/*.test.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/test/**/*.ts"]
        },
        "packages/create-historic-city": {
            "entry": ["cli.ts", "test/**/*.test.ts"],
            "project": ["*.ts", "src/**/*.ts", "test/**/*.ts"]
        },
        "packages/*": {
            "entry": ["test/**/*.test.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts"]
        },
        "e2e": {
            "entry": ["test/**/*.test.ts", "split-reporter.ts"],
            "project": ["**/*.ts"]
        }
    },
    "ignoreDependencies": ["braces"]
}
