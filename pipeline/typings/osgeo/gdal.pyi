"""Stubs for the part of `osgeo.gdal` (GDAL 3.13) the repository calls.

GDAL's names are CamelCase (GetDriverByName, WriteArray) and the stubs spell them as GDAL does; ruff.toml
allows N802 for `pipeline/typings/**/*.pyi` only. Arguments are positional-only where the callers pass them
positionally; the utilities (`Translate`, `Warp`, `Info`) take GDAL's keyword options.
"""

from collections.abc import Callable, Sequence
from typing import Any, overload

from numpy.typing import NDArray

__version__: str

GDT_Byte: int
GDT_UInt16: int
GDT_Float32: int
GCI_GrayIndex: int
GCI_RedBand: int
GCI_GreenBand: int
GCI_BlueBand: int
GCI_AlphaBand: int

GeoTransform = tuple[float, float, float, float, float, float]
ProgressCallback = Callable[[float, str, object], int]

class GCP:
    GCPX: float
    GCPY: float
    GCPZ: float
    GCPPixel: float
    GCPLine: float
    def __init__(self, x: float, y: float, z: float, pixel: float, line: float, /) -> None: ...

class Band:
    DataType: int
    XSize: int
    YSize: int
    def WriteArray(self, array: NDArray[Any], /) -> int: ...
    def ReadAsArray(
        self,
        xoff: int = 0,
        yoff: int = 0,
        win_xsize: int | None = None,
        win_ysize: int | None = None,
        buf_xsize: int | None = None,
        buf_ysize: int | None = None,
    ) -> NDArray[Any]: ...
    def Checksum(self) -> int: ...
    def GetColorInterpretation(self) -> int: ...
    def SetColorInterpretation(self, interpretation: int, /) -> int: ...
    def GetOverviewCount(self) -> int: ...
    def GetMaskFlags(self) -> int: ...
    def GetMaskBand(self) -> Band: ...

class Dataset:
    RasterXSize: int
    RasterYSize: int
    RasterCount: int
    def GetRasterBand(self, index: int, /) -> Band: ...
    @overload
    def GetGeoTransform(self) -> GeoTransform: ...
    @overload
    def GetGeoTransform(self, can_return_null: bool) -> GeoTransform | None: ...
    def SetGeoTransform(self, transform: GeoTransform, /) -> int: ...
    def GetProjection(self) -> str: ...
    def SetProjection(self, wkt: str, /) -> int: ...
    def GetGCPCount(self) -> int: ...
    def GetGCPs(self) -> Sequence[GCP]: ...
    def GetGCPProjection(self) -> str: ...
    def SetGCPs(self, gcps: Sequence[GCP], wkt: str, /) -> int: ...
    def FlushCache(self) -> int: ...
    def Close(self) -> int: ...

class Driver:
    ShortName: str
    def Create(self, path: str, xsize: int, ysize: int, bands: int, data_type: int, options: Sequence[str] = ..., /) -> Dataset: ...

def UseExceptions() -> None: ...
def GetDriverByName(name: str, /) -> Driver | None: ...
def Open(path: str, /) -> Dataset: ...
def SetConfigOption(key: str, value: str | None, /) -> None: ...
def GetConfigOption(key: str, default: str | None = None, /) -> str | None: ...
def Translate(destination: str, source: Dataset | str, /, **options: Any) -> Dataset: ...
def Warp(destination: str, sources: Dataset | str | Sequence[Dataset | str], /, **options: Any) -> Dataset: ...
def Info(ds: Dataset | str, **options: Any) -> Any: ...
def Unlink(path: str, /) -> int: ...
