// Playwright end-to-end tests (@hcm/e2e): the config, the fixtures and the specs. They run in Node
// (process.env, the Playwright runner) and pass callbacks into the page (DOM types), so both apply.
{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"]
    },
    "include": ["playwright.config.ts", "support", "specs"]
}
