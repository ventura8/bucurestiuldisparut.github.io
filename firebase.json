{
    "$schema": "./node_modules/firebase-tools/schema/firebase-config.json",
    "firestore": {
        "database": "(default)",
        "rules": "firebase/firestore.rules",
        "indexes": "firebase/firestore.indexes.json"
    },
    "storage": {
        "rules": "firebase/storage.rules"
    },
    "functions": [
        {
            "source": "functions/dist",
            "codebase": "default",
            "runtime": "nodejs24",
            "disallowLegacyRuntimeConfig": true,
            "ignore": ["node_modules", ".git", "*.local", "firebase-debug.log", "firebase-debug.*.log"],
            "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build --workspace @hcm/functions"]
        }
    ],
    "hosting": {
        "site": "bucurestiul-disparut",
        "public": "packages/admin/dist",
        "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build:admin"],
        "cleanUrls": true,
        "trailingSlash": false,
        "ignore": ["**/.*", "**/*.map"],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "Content-Security-Policy",
                        "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://api.mapbox.com/mapbox-gl-js/ https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.googletagmanager.com; style-src 'self' https://api.mapbox.com/mapbox-gl-js/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: blob: https://storage.googleapis.com https://firebasestorage.googleapis.com https://api.mapbox.com https://lh3.googleusercontent.com https://tile.openstreetmap.org https://*.google-analytics.com https://*.googletagmanager.com; frame-src 'self' https://bucurestiul-disparut.web.app https://bucurestiul-disparut.firebaseapp.com https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
                    },
                    {
                        "key": "Content-Security-Policy-Report-Only",
                        "value": "require-trusted-types-for 'script'"
                    },
                    {
                        "key": "Cross-Origin-Opener-Policy",
                        "value": "same-origin-allow-popups"
                    },
                    {
                        "key": "Referrer-Policy",
                        "value": "strict-origin-when-cross-origin"
                    },
                    {
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    },
                    {
                        "key": "Permissions-Policy",
                        "value": "camera=(), microphone=(), geolocation=(self)"
                    }
                ]
            },
            {
                "source": "**/*.@(html|js|mjs|css|json)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "legacy/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            }
        ]
    },
    "emulators": {
        "singleProjectMode": true,
        "hub": {
            "host": "127.0.0.1",
            "port": 4400
        },
        "logging": {
            "host": "127.0.0.1",
            "port": 4500
        },
        "auth": {
            "host": "127.0.0.1",
            "port": 9099
        },
        "firestore": {
            "host": "127.0.0.1",
            "port": 8080,
            "websocketPort": 9150
        },
        "storage": {
            "host": "127.0.0.1",
            "port": 9199
        },
        "functions": {
            "host": "127.0.0.1",
            "port": 5001
        },
        "hosting": {
            "host": "127.0.0.1",
            "port": 5000
        },
        "pubsub": {
            "host": "127.0.0.1",
            "port": 8085
        },
        "tasks": {
            "host": "127.0.0.1",
            "port": 9499
        },
        "ui": {
            "enabled": false
        }
    }
}
